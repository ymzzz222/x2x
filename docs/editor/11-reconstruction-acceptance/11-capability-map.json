    {
      "category": "重复块",
      "source": "../10-related-features-and-edge-cases/10-acceptance-and-gaps.md",
      "contract": "额外空段与重复正文分开，Undo不变量及范围断言保留",
      "limit": "重复请求、晚响应和迁移重放未验证"
    },
    {
      "category": "残留菜单",
      "source": "../07-menus-and-shortcuts/07-verification-matrix.md",
      "contract": "取消和互斥后的菜单/焦点状态回到具体有效窗口",
      "limit": "全入口与会话生命周期组合未完成"
    },
    {
      "category": "编号漂移",
      "source": "../06-numbering-folding-and-outline/06-verification-matrix.md",
      "contract": "标记、起点、续号与后代范围分开；F04异常窗口不抹去",
      "limit": "任意深度、导入与并发编号全组合未验证"
    },
    {
      "category": "部分成功",
      "source": "../08-deletion-movement-formatting-and-clipboard/08-selection-deletion.md",
      "contract": "输入无变化、删除合并和部分作用范围必须比较前后缀",
      "limit": "所有失败前修改及事务原子性不能由DOM推定"
    }
